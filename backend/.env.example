# Copy to .env. Blank values count as unset. Never commit real secrets.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Runtime connection.
# Local: matches `npm run db:local`.
# Supabase: Dashboard > Connect > Transaction pooler (port 6543), add ?sslmode=require.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/rally
# Migrations only, optional, falls back to DATABASE_URL.
# Supabase: use the session pooler (port 5432), not the transaction pooler. The direct host is IPv6-only.
DATABASE_MIGRATION_URL=
DATABASE_POOL_MAX=10

# Comma-separated exact browser origins. Required in production; "*" is rejected.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:3001

# Set true only when running behind a reverse proxy you control.
TRUST_PROXY=false

# Per-IP limit across all routes except health checks.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# Forced exit if graceful shutdown takes longer than this.
SHUTDOWN_TIMEOUT_MS=15000

# Background outbox worker and scheduler, run inside this process.
WORKERS_ENABLED=true
OUTBOX_POLL_MS=1000
SCHEDULER_INTERVAL_MS=30000
# Enables GET /internal/metrics. At least 32 characters.
ADMIN_API_TOKEN=

# Event configuration.
EVENT_ZONES=venue-floor-1,venue-floor-2,venue-nearby
# Used to resolve words like "tonight" when the client sends no time zone.
EVENT_TIME_ZONE=Asia/Kolkata
# Optional, e.g. 2026-11-08T09:00:00+05:30. Activities must end before this.
EVENT_END=
OFFER_HOLD_MINUTES=30

# Privy. Required in production. Without them, authenticated routes return 503.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Optional: verifies tokens locally rather than fetching the JWKS. Dashboard > App settings.
PRIVY_VERIFICATION_KEY=

# 0G Compute Router: create a key and choose an available model at https://pc.0g.ai
# Without both, Rally uses deterministic fallbacks.
ZERO_G_API_KEY=
ZERO_G_MODEL=qwen3.7-flash
# true makes startup fail when the two above are missing, and makes matching retry through 0G outages
# rather than use the deterministic composer, so a fallback cannot pass as AI in a demo.
AI_REQUIRED=false
# Live calls took 7 to 24 seconds. Too low, and most requests fall back.
AI_TIMEOUT_MS=60000
# Includes any reasoning tokens counted against the provider completion budget.
AI_MAX_OUTPUT_TOKENS=4096

# Arkiv. Without a private key, listings are not written. Keep this key secret.
ARKIV_PRIVATE_KEY=
# RPC access key from hub.arkiv.network/access-keys. Separate from the wallet key.
ARKIV_ACCESS_KEY=
# Optional override, e.g. a community RPC. Defaults to the Rabdi endpoint.
ARKIV_RPC_URL=
ARKIV_APP=rally-mumbai
ARKIV_EVENT=ethglobal-mumbai-2026
ARKIV_SCHEMA_NAME=rally-mumbai.activity.v1
ARKIV_QUERY_PAGE_SIZE=40
ARKIV_QUERY_TIMEOUT_MS=5000

# Optional on-chain reward claims. Core Rally does not need these.
REWARDS_CLAIMS_ENABLED=false
REWARD_SIGNER_PRIVATE_KEY=
REWARD_CLAIM_CONTRACT=
REWARD_CHAIN_ID=
REWARD_TOKEN_UNITS_PER_POINT=
REWARD_VOUCHER_TTL_MINUTES=60
