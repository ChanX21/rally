# Copy to .env.local. Both values reach the browser, so never put a secret here.

# Rally backend. Add this app's origin (http://localhost:3000) to CORS_ORIGINS in backend/.env.
NEXT_PUBLIC_API_URL=http://localhost:3123

# Must be the same app id as PRIVY_APP_ID in backend/.env, or every token is rejected.
NEXT_PUBLIC_PRIVY_APP_ID=
