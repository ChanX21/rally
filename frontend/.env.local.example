# Copy to .env.local and fill in. .env.local is gitignored.

# Privy app id — MUST be the same app id the backend uses, or every token the
# frontend mints will be rejected. Get it from Harshed. Never put the secret here.
NEXT_PUBLIC_PRIVY_APP_ID=

# Base URL of the Rally backend. No deployed URL yet; keep it configurable.
NEXT_PUBLIC_API_URL=http://localhost:3000
